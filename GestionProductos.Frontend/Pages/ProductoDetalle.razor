@page "/productos/{id:int}"
@using GestionProductos.Frontend.Models
@using GestionProductos.Frontend.Services
@inject IProductoService ProductoService
@inject NavigationManager Navigation

<PageTitle>Detalle del Producto</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (producto == null)
            {
                <div class="text-center my-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2">Cargando detalle del producto...</p>
                </div>
            }
            else
            {
                <div class="card shadow">
                    <div class="card-header bg-info text-white">
                        <h4 class="mb-0">
                            <i class="bi bi-info-circle"></i> Detalle del Producto
                        </h4>
                    </div>

                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h5 class="border-bottom pb-2">Información Básica</h5>

                                <table class="table table-borderless">
                                    <tr>
                                        <th class="text-muted">ID:</th>
                                        <td><span class="badge bg-secondary">@producto.Id</span></td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted">Código:</th>
                                        <td><span class="badge bg-info text-dark">@producto.Codigo</span></td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted">Nombre:</th>
                                        <td><strong>@producto.Nombre</strong></td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted">Precio:</th>
                                        <td class="fw-bold text-success fs-4">@($"Q{producto.Precio:N2}")</td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted">Stock:</th>
                                        <td>
                                            @if (producto.Stock > 0)
                                            {
                                                <span class="badge bg-success">@producto.Stock unidades disponibles</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Agotado</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted">Estado:</th>
                                        <td>
                                            @if (producto.Activo)
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary"><i class="bi bi-x-circle"></i> Inactivo</span>
                                            }
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-md-6">
                                <h5 class="border-bottom pb-2">Auditoría</h5>

                                <div class="card bg-light">
                                    <div class="card-body">
                                        <p>
                                            <i class="bi bi-calendar-plus text-primary"></i>
                                            <strong>Fecha de Creación:</strong><br />
                                            @producto.CreatedAt.ToString("dddd, dd 'de' MMMM 'de' yyyy HH:mm:ss")
                                        </p>

                                        @if (producto.UpdatedAt.HasValue)
                                        {
                                            <p class="mt-3">
                                                <i class="bi bi-calendar-check text-warning"></i>
                                                <strong>Última Actualización:</strong><br />
                                                @producto.UpdatedAt.Value.ToString("dddd, dd 'de' MMMM 'de' yyyy HH:mm:ss")
                                            </p>
                                        }

                                        <p class="mt-3 mb-0">
                                            <i class="bi bi-clock-history text-info"></i>
                                            <strong>Tiempo desde creación:</strong><br />
                                            @((DateTime.Now - producto.CreatedAt).Days) días
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer">
                        <div class="d-flex justify-content-between">
                            <button class="btn btn-secondary" @onclick="VolverAlListado">
                                <i class="bi bi-arrow-left"></i> Volver al Listado
                            </button>
                            <div>
                                <button class="btn btn-warning me-2" @onclick="IrAEditar">
                                    <i class="bi bi-pencil"></i> Editar
                                </button>
                                @if (producto.Activo)
                                {
                                    <button class="btn btn-danger" @onclick="() => EliminarProducto(producto)">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Producto? producto;

    protected override async Task OnInitializedAsync()
    {
        await CargarProducto();
    }

    private async Task CargarProducto()
    {
        try
        {
            producto = await ProductoService.GetProducto(Id);
            if (producto == null)
            {
                Navigation.NavigateTo("/productos");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando producto: {ex.Message}");
            Navigation.NavigateTo("/productos");
        }
    }

    private void IrAEditar()
    {
        if (producto != null)
        {
            Navigation.NavigateTo($"/productos/editar/{producto.Id}");
        }
    }

    private async Task EliminarProducto(Producto producto)
    {
        var confirmar = await JSRuntime.InvokeAsync<bool>("confirmarEliminacion", $"¿Está seguro de eliminar el producto {producto.Nombre}?");
        if (confirmar)
        {
            await ProductoService.DeleteProducto(producto.Id);
            Navigation.NavigateTo("/productos");
        }
    }

    private void VolverAlListado()
    {
        Navigation.NavigateTo("/productos");
    }

    [Inject] private IJSRuntime JSRuntime { get; set; }
}